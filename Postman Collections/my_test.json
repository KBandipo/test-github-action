	"item": [
		{
			"name": "AddBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "6a7917f1-7851-423c-8ef2-d30471f17be7",
						"exec": [
							"const jsonData = pm.response.json();\r",
							"const bookId = jsonData.ID;\r",
							"pm.environment.set(\"book_id\", bookId);\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Validate AddBook returns 200 Status Code\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    pm.expect(jsonData).to.have.property(\"Msg\");\r",
							"    pm.expect(jsonData.Msg).to.equal(\"successfully added\");\r",
							"})\r",
							"\r",
							"pm.test(\"Headers cookies responseTime validation\", function () {\r",
							"    pm.response.to.have.header(\"content-Type\");\r",
							"    pm.expect(pm.response.headers.get(\"content-Type\")).to.equal(\"application/json;charset=UTF-8\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response time is less than 2200ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2200);\r",
							"});\r",
							"\r",
							"pm.test(\"Validate ID logic\", function (){\r",
							"    const isbn_val = pm.collectionVariables.get(\"isbn\");\r",
							"    const req = JSON.parse(pm.request.body.raw);\r",
							"    const aisle_val = req.aisle;\r",
							"    pm.expect(isbn_val + aisle_val).to.be.eql(bookId);\r",
							"})\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"id": "883e1cbe-be81-418b-9747-d08a92115e55",
						"exec": [
							"const code = pm.globals.get(\"companyCode\");\r",
							"const val = pm.variables.replaceIn('{{$randomInt}}')\r",
							"pm.collectionVariables.set(\"isbn\", code + val);\r",
							"pm.collectionVariables.set(\"book_name\", pm.iterationData.get(\"BookName\"));\r",
							"console.log(pm.collectionVariables.get(\"book_name\"));\r",
							"pm.collectionVariables.set(\"author_name\", pm.iterationData.get(\"Author\"));\r",
							"console.log(pm.collectionVariables.get(\"author_name\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"id": "7e565071-cd07-4c61-a399-be9eff219b3c",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\":\"{{book_name}}\",\r\n\"isbn\":\"{{isbn}}\",\r\n\"aisle\":\"99\",\r\n\"author\":\"{{author_name}}\"\r\n}\r\n ",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{base_url}}//Library/Addbook.php"
			},
			"response": []
		},
		{
			"name": "GetBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "e6aac98e-5943-479c-869c-1c9901c8d58d",
						"exec": [
							"const getBookResponse = pm.response.json();\r",
							"\r",
							"const schema = {\r",
							"  \"type\": \"array\",\r",
							"  \"items\": [\r",
							"    {\r",
							"      \"type\": \"object\",\r",
							"      \"properties\": {\r",
							"        \"book_name\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"isbn\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"aisle\": {\r",
							"          \"type\": \"string\"\r",
							"        },\r",
							"        \"author\": {\r",
							"          \"type\": \"string\"\r",
							"        }\r",
							"      },\r",
							"      \"required\": [\r",
							"        \"book_name\",\r",
							"        \"isbn\",\r",
							"        \"aisle\",\r",
							"        \"author\"\r",
							"      ]\r",
							"    }\r",
							"  ]\r",
							"};\r",
							"\r",
							"pm.test(\"Validate json response\", function (){\r",
							"    const authorName = pm.collectionVariables.get(\"author_name\");\r",
							"    pm.expect(getBookResponse[0].author).to.eql(authorName);\r",
							"})\r",
							"\r",
							"pm.test(\"Validate json response schema\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    pm.response.to.have.jsonSchema(schema);\r",
							"    pm.expect(getBookResponse).to.be.jsonSchema(schema);\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
